<?xml version="1.0" encoding="UTF-8"?>
<!DOCTYPE plist PUBLIC "-//Apple//DTD PLIST 1.0//EN" "http://www.apple.com/DTDs/PropertyList-1.0.dtd">
<plist version="1.0">
<dict>
    <key>Label</key>
    <string>com.darl.networth-refresh</string>

    <key>ProgramArguments</key>
    <array>
        <string>/bin/bash</string>
        <string>/Users/thej/Github/AIAppGenerator/refresh_networth.sh</string>
    </array>

    <!-- Run every day at 21:00 (9pm) local time -->
    <key>StartCalendarInterval</key>
    <dict>
        <key>Hour</key>
        <integer>21</integer>
        <key>Minute</key>
        <integer>0</integer>
    </dict>

    <!-- If the Mac was asleep at 21:00, run as soon as it wakes -->
    <key>RunAtLoad</key>
    <false/>

    <key>StandardOutPath</key>
    <string>/Users/thej/Library/Logs/networth-refresh.out.log</string>
    <key>StandardErrorPath</key>
    <string>/Users/thej/Library/Logs/networth-refresh.err.log</string>
</dict>
</plist>
