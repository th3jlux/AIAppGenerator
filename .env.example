# Copy this file to `.env` and fill in your values. `.env` is gitignored.

# Required: your OpenAI API key (https://platform.openai.com/api-keys)
OPENAI_API_KEY=sk-...

# Optional overrides
# OPENAI_MODEL=gpt-4o
# FLASK_SECRET_KEY=change-me-to-a-long-random-string
# FLASK_HOST=127.0.0.1
# FLASK_PORT=5001
# FLASK_DEBUG=1
