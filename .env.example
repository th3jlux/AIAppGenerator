# Copy this file to `.env` and fill in your values. `.env` is gitignored.

# Required: your OpenAI API key (https://platform.openai.com/api-keys)
OPENAI_API_KEY=sk-...

# Optional overrides
# Editor model. gpt-4o-mini is the default: cheap and high rate limit. The page
# editor sends the whole file as context, so larger models can hit per-minute
# token limits (429) on big pages. Use gpt-4o only on a higher usage tier.
# OPENAI_MODEL=gpt-4o-mini
# FLASK_SECRET_KEY=change-me-to-a-long-random-string
# FLASK_HOST=127.0.0.1
# FLASK_PORT=5001
# FLASK_DEBUG=1
